{
 "version": "1.0.0",
 "pageSpecTokenFields": {
  "surface": {
   "category": "surface"
  },
  "text": {
   "category": "text"
  },
  "accent": {
   "category": "accent"
  },
  "spaceBlock": {
   "category": "spacing"
  },
  "font": {
   "category": "fontFamily"
  }
 },
 "fontFamilyAllowed": [
  "font.family.display"
 ],
 "rawValueRestrictions": {
  "color": {
   "rule": "TOKEN_RAW_COLOR",
   "regex": "(?i)(#[0-9a-f]{3,8}\\b|\\brgba?\\(|\\bhsla?\\(|\\b(red|black|white|blue|green|orange|purple|pink|gray|grey|yellow)\\b)"
  },
  "spacing": {
   "rule": "TOKEN_ARBITRARY_SPACING",
   "regex": "(?i)^-?[0-9.]+\\s*(px|rem|em|%|vw|vh)?$"
  },
  "fontFamily": {
   "rule": "TOKEN_FONT_UNSUPPORTED",
   "allowed": [
    "font.family.display"
   ]
  }
 },
 "surfaceTextPairs": {
  "surface.page": [
   "text.primary"
  ],
  "surface.paper": [
   "text.primary"
  ],
  "surface.cream": [
   "text.primary"
  ],
  "surface.brand": [
   "text.on-dark"
  ],
  "surface.ink": [
   "text.on-dark",
   "text.muted-on-dark"
  ],
  "surface.accent": [
   "text.on-dark",
   "text.muted-on-dark"
  ]
 },
 "themes": {
  "light": [
   "surface.page",
   "surface.paper",
   "surface.cream",
   "surface.brand",
   "surface.ink",
   "surface.accent"
  ]
 },
 "accentRules": {
  "surface.accent requires node.tokens.accent": true,
  "accent only on sections whose contract has tokens.accent=true": true
 },
 "sectionSurfaces": "Read from each section contract's tokens.surfaces / tokens.text (single source of truth).",
 "enforced": [
  "TOKEN_UNKNOWN",
  "TOKEN_CATEGORY",
  "TOKEN_RAW_COLOR",
  "TOKEN_ARBITRARY_SPACING",
  "TOKEN_FONT_UNSUPPORTED",
  "TOKEN_THEME_COMBINATION",
  "TOKEN_SURFACE_NOT_ALLOWED",
  "TOKEN_ACCENT_REQUIRED",
  "TOKEN_ACCENT_NOT_ALLOWED"
 ],
 "convention": [
  "TOKEN_NOT_REFERENCEABLE is implemented as a backstop but currently unreachable: every token in a PageSpec-field category is referenceable except font.family.ua-button, which TOKEN_FONT_UNSUPPORTED rejects first.",
  "Type scale, radius, motion and breakpoint tokens are owned by the section contracts; a PageSpec does not override them (no per-instance typography field exists)."
 ],
 "evidence": [
  {
   "cite": "CLONE_SPEC.md:54",
   "needle": "### 2.2 Colors (computed)"
  },
  {
   "cite": ".recon/pages/index.html:87",
   "needle": "<style>:root{--motion-fast:200ms"
  }
 ]
}
