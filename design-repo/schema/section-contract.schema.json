{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Section contract",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "title",
  "version",
  "purpose",
  "semantic",
  "source",
  "implementedBy",
  "retrievalEligible",
  "constraints",
  "variants",
  "content",
  "motion",
  "tokens",
  "responsive",
  "referenceAssetRoles",
  "generatedAssetRoles",
  "measured",
  "evidence"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z]+\\.[a-z0-9-]+$"
  },
  "title": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "purpose": {
   "type": "string",
   "minLength": 20
  },
  "semantic": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "category"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "category": {
     "enum": [
      "SHELL",
      "UTILITY",
      "HERO",
      "INDEX",
      "CTA",
      "CONVERSION",
      "PROOF",
      "ABOUT",
      "EDITORIAL",
      "MEDIA",
      "SHOWCASE",
      "DETAIL",
      "CREDITS"
     ]
    }
   }
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "file",
    "tag",
    "lines",
    "needle"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "file": {
     "type": "string"
    },
    "tag": {
     "type": "string"
    },
    "lines": {
     "type": "string",
     "pattern": "^[0-9]+(-[0-9]+)?$"
    },
    "needle": {
     "type": "string"
    }
   }
  },
  "implementedBy": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "cite",
     "needle"
    ],
    "properties": {
     "cite": {
      "type": "string"
     },
     "needle": {
      "type": "string"
     }
    }
   }
  },
  "retrievalEligible": {
   "type": "boolean"
  },
  "retrievalReason": {
   "type": "string",
   "minLength": 30
  },
  "constraints": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "onePerPage": {
     "type": "boolean"
    },
    "maxPerPage": {
     "type": "integer"
    },
    "mustBeFirst": {
     "type": "boolean"
    },
    "mustBeFirstContent": {
     "type": "boolean"
    },
    "mustBeLast": {
     "type": "boolean"
    },
    "requires": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "templates": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "variants": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "content": {
   "type": "object"
  },
  "motion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "allowed",
    "default"
   ],
   "properties": {
    "allowed": {
     "type": "array",
     "minItems": 1,
     "items": {
      "enum": [
       "reveal-up",
       "reveal-stagger",
       "reveal-fade",
       "hero-entrance",
       "title-rotate",
       "mouse-depth",
       "scroll-parallax",
       "hint-breathe",
       "word-cycle",
       "clip-panel",
       "card-grow",
       "load-more-expand",
       "underline-grow",
       "roll-ink",
       "marquee",
       "signature-draw",
       "panel-slide",
       "preloader-trace",
       "shared-element-arrival",
       "return-fade",
       "anchor-scroll",
       "slider-drag",
       "lightbox",
       "none"
      ]
     }
    },
    "default": {
     "enum": [
      "reveal-up",
      "reveal-stagger",
      "reveal-fade",
      "hero-entrance",
      "title-rotate",
      "mouse-depth",
      "scroll-parallax",
      "hint-breathe",
      "word-cycle",
      "clip-panel",
      "card-grow",
      "load-more-expand",
      "underline-grow",
      "roll-ink",
      "marquee",
      "signature-draw",
      "panel-slide",
      "preloader-trace",
      "shared-element-arrival",
      "return-fade",
      "anchor-scroll",
      "slider-drag",
      "lightbox",
      "none"
     ]
    }
   }
  },
  "tokens": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "surfaces",
    "text",
    "accent"
   ],
   "properties": {
    "surfaces": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "text": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "accent": {
     "type": "boolean"
    }
   }
  },
  "responsive": {
   "type": "object"
  },
  "referenceAssetRoles": {
   "type": "array",
   "items": {
    "enum": [
     "brand.monogram",
     "brand.project-mark",
     "brand.signature-trace",
     "brand.wordmark",
     "fictional.person-avatar",
     "font.display-face",
     "generated.brand-mark",
     "generated.project-visual",
     "icon.ui",
     "licensed-or-fallback.font",
     "original.copy",
     "partner.logo",
     "placeholder.award-label",
     "placeholder.brand-mark",
     "placeholder.partner-mark",
     "placeholder.project-video",
     "placeholder.url",
     "social.share-image",
     "work.card-media",
     "work.gallery-media",
     "work.hero-media",
     "work.video"
    ]
   }
  },
  "generatedAssetRoles": {
   "type": "array",
   "items": {
    "enum": [
     "brand.monogram",
     "brand.project-mark",
     "brand.signature-trace",
     "brand.wordmark",
     "fictional.person-avatar",
     "font.display-face",
     "generated.brand-mark",
     "generated.project-visual",
     "icon.ui",
     "licensed-or-fallback.font",
     "original.copy",
     "partner.logo",
     "placeholder.award-label",
     "placeholder.brand-mark",
     "placeholder.partner-mark",
     "placeholder.project-video",
     "placeholder.url",
     "social.share-image",
     "work.card-media",
     "work.gallery-media",
     "work.hero-media",
     "work.video"
    ]
   }
  },
  "measured": {
   "type": "object"
  },
  "evidence": {
   "type": "array"
  }
 },
 "if": {
  "properties": {
   "retrievalEligible": {
    "const": false
   }
  }
 },
 "then": {
  "required": [
   "retrievalReason"
  ]
 }
}
