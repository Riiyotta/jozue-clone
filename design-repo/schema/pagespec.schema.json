     "minLength": 1
    },
    "quote": {
     "type": "string",
     "minLength": 1
    },
    "media": {
     "$ref": "#/definitions/media"
    }
   }
  },
  "content.brand.palette": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "swatches"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
