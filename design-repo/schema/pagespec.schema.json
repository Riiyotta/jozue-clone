   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "media": {
     "type": "array",
     "minItems": 2,
     "maxItems": 12,
     "items": {
      "$ref": "#/definitions/media"
     }
    }
   }
  },
  "content.editorial.quote": {
   "type": "object",
   "additionalProperties": false,
