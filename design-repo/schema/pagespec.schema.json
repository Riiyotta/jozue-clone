{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "design-repo/schema/pagespec.schema.json",
 "title": "PageSpec",
 "description": "A page composed from this design-repo. mode=reference reconstructs the source faithfully; mode=generated builds a new page for someone else and must contain no source identity or content (enforced by schema/semantic_validate.py GENERATED_MODE_* rules).",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "pageSpecVersion",
  "mode",
  "template",
  "route",
  "locale",
  "theme",
  "meta",
  "brand",
  "nodes"
 ],
 "properties": {
  "pageSpecVersion": {
   "const": "1.0.0"
  },
  "mode": {
   "enum": [
    "reference",
    "generated"
   ]
  },
  "template": {
   "enum": [
    "home",
    "work-detail",
    "not-found"
   ]
  },
  "route": {
   "type": "string",
   "pattern": "^/"
  },
  "locale": {
   "enum": [
    "en",
    "fr"
   ]
  },
  "theme": {
   "enum": [
    "light"
   ]
  },
  "meta": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "description"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "description": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "brand": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "domain"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1
    },
    "domain": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "nodes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/definitions/node"
   }
  }
 },
 "definitions": {
  "link": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "label",
    "href"
   ],
   "properties": {
    "label": {
     "type": "string",
     "minLength": 1
    },
    "href": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "media": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "assetRole",
    "ref",
    "alt"
   ],
   "properties": {
    "assetRole": {
     "enum": [
      "brand.monogram",
      "brand.project-mark",
      "brand.signature-trace",
      "brand.wordmark",
      "fictional.person-avatar",
      "font.display-face",
      "generated.brand-mark",
      "generated.project-visual",
      "icon.ui",
      "licensed-or-fallback.font",
      "original.copy",
      "partner.logo",
      "placeholder.award-label",
      "placeholder.brand-mark",
      "placeholder.partner-mark",
      "placeholder.project-video",
      "placeholder.url",
      "social.share-image",
      "work.card-media",
      "work.gallery-media",
      "work.hero-media",
      "work.video"
     ]
    },
    "ref": {
     "type": "string",
     "minLength": 1
    },
    "alt": {
     "type": "string"
    }
   }
  },
  "tokens": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "surface": {
     "type": "string",
     "minLength": 1
    },
    "text": {
     "type": "string",
     "minLength": 1
    },
    "accent": {
     "type": "string",
     "minLength": 1
    },
    "spaceBlock": {
     "type": "string",
     "minLength": 1
    },
    "font": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "motion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "pattern",
    "reducedMotionFallback"
   ],
   "properties": {
    "pattern": {
     "enum": [
      "reveal-up",
      "reveal-stagger",
      "reveal-fade",
      "hero-entrance",
      "title-rotate",
      "mouse-depth",
      "scroll-parallax",
      "hint-breathe",
      "word-cycle",
      "clip-panel",
      "card-grow",
      "load-more-expand",
      "underline-grow",
      "roll-ink",
      "marquee",
      "signature-draw",
      "panel-slide",
      "preloader-trace",
      "shared-element-arrival",
      "return-fade",
      "anchor-scroll",
      "slider-drag",
      "lightbox",
      "none"
     ]
    },
    "reducedMotionFallback": {
     "enum": [
      "instant-static",
      "opacity-only-150ms",
      "none"
     ]
    }
   }
  },
  "content.shell.page-transition": {
   "type": "object",
   "additionalProperties": false,
   "required": [],
   "properties": {}
  },
  "content.shell.intro-preloader": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "skipLabel",
    "greeting"
   ],
   "properties": {
    "skipLabel": {
     "type": "string",
     "minLength": 1
    },
    "greeting": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "content.shell.site-menu": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "links",
    "languageLinks"
   ],
   "properties": {
    "links": {
     "type": "array",
     "minItems": 1,
     "maxItems": 3,
     "items": {
      "$ref": "#/definitions/link"
     }
    },
    "languageLinks": {
     "type": "array",
     "minItems": 1,
     "maxItems": 2,
     "items": {
      "$ref": "#/definitions/link"
     }
    }
   }
  },
  "content.utility.filter-island": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sentence",
    "connector",
    "leftWords",
    "rightWords",
    "allLabel"
   ],
   "properties": {
    "sentence": {
     "type": "string",
     "minLength": 1
    },
    "connector": {
     "type": "string",
     "minLength": 1
    },
    "leftWords": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "rightWords": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "allLabel": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "content.hero.home-intro": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "navLinks",
    "greeting",
    "titleVariants",
    "description",
    "addressLinks",
    "scrollHint"
   ],
   "properties": {
    "navLinks": {
     "type": "array",
     "minItems": 1,
     "maxItems": 3,
     "items": {
      "$ref": "#/definitions/link"
     }
    },
    "greeting": {
     "type": "array",
     "minItems": 1,
     "maxItems": 2,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "titleVariants": {
     "type": "array",
     "minItems": 1,
     "maxItems": 3,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "line1",
       "line2"
      ],
      "properties": {
       "line1": {
        "type": "string",
        "minLength": 1
       },
       "line2": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "description": {
     "type": "array",
     "minItems": 1,
     "maxItems": 2,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "addressLinks": {
     "type": "array",
     "minItems": 1,
     "maxItems": 3,
     "items": {
      "$ref": "#/definitions/link"
     }
    },
    "scrollHint": {
     "type": "string",
     "minLength": 1
    },
    "backgroundMark": {
     "$ref": "#/definitions/media"
    }
   }
  },
  "content.works.selected-header": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "count",
    "filterSentence",
    "categoriesLeft",
    "categoriesRight"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "filterSentence": {
     "type": "string",
     "minLength": 1
    },
    "categoriesLeft": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "label",
       "slug",
       "count"
      ],
      "properties": {
       "label": {
        "type": "string",
        "minLength": 1
       },
       "slug": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
       },
       "count": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    },
    "categoriesRight": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "label",
       "slug",
       "count"
      ],
      "properties": {
       "label": {
        "type": "string",
        "minLength": 1
       },
       "slug": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
       },
       "count": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    }
   }
  },
  "content.works.card-list": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "cards",
    "loadMoreLabel",
    "mobileInitialCount"
   ],
   "properties": {
    "cards": {
     "type": "array",
     "minItems": 1,
     "maxItems": 24,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "title",
       "href",
       "categories",
       "accent",
       "media"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "href": {
        "type": "string",
        "minLength": 1
       },
       "categories": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "accent": {
        "type": "string",
        "minLength": 1
       },
       "slogan": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "media": {
        "$ref": "#/definitions/media"
       },
       "heroMedia": {
        "$ref": "#/definitions/media"
       }
      }
     }
    },
    "loadMoreLabel": {
     "type": "string",
     "minLength": 1
    },
    "mobileInitialCount": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "content.cta.got-project": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "label",
    "target"
   ],
   "properties": {
    "label": {
     "type": "string",
     "minLength": 1
    },
    "target": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "content.cta.lets-talk": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "description",
    "availability",
    "link"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "description": {
     "type": "string",
     "minLength": 1
    },
    "availability": {
     "type": "string",
     "minLength": 1
    },
    "link": {
     "$ref": "#/definitions/link"
    },
    "backgroundMark": {
     "$ref": "#/definitions/media"
    }
   }
  },
  "content.proof.awards": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "awards"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "awards": {
     "type": "array",
     "minItems": 1,
     "maxItems": 12,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "context",
       "title",
       "tags",
       "recognitions",
       "recognitionSource"
      ],
      "properties": {
       "context": {
        "type": "string",
        "minLength": 1
       },
       "title": {
        "type": "string",
        "minLength": 1
       },
       "href": {
        "type": "string",
        "minLength": 1
       },
       "tags": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "recognitions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "recognitionSource": {
        "enum": [
         "real",
         "placeholder"
        ]
       }
      }
     }
    }
   }
  },
  "content.about.bio": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "label",
    "heading",
    "skills",
    "paragraphs",
    "availability",
    "link"
   ],
   "properties": {
    "label": {
     "type": "string",
     "minLength": 1
    },
    "heading": {
     "type": "string",
     "minLength": 1
    },
    "skills": {
     "type": "array",
     "minItems": 1,
     "maxItems": 16,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "paragraphs": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "availability": {
     "type": "string",
     "minLength": 1
    },
    "link": {
     "$ref": "#/definitions/link"
    },
    "mark": {
     "$ref": "#/definitions/media"
    }
   }
  },
  "content.proof.partners": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "partners"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "partners": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "name",
       "role",
       "href",
       "logo"
      ],
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1
       },
       "role": {
        "type": "string",
        "minLength": 1
       },
       "href": {
        "type": "string",
        "minLength": 1
       },
       "logo": {
        "$ref": "#/definitions/media"
       }
      }
     }
    }
   }
  },
  "content.contact.details": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "socials",
    "phone",
    "email"
   ],
   "properties": {
    "socials": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4,
     "items": {
      "$ref": "#/definitions/link"
     }
    },
    "phone": {
     "type": "string",
     "pattern": "^tel:\\+[0-9]{6,15}$"
    },
    "email": {
     "$ref": "#/definitions/link"
    },
    "backgroundMark": {
     "$ref": "#/definitions/media"
    }
   }
  },
  "content.hero.work-head": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "backLink",
    "name",
    "categories",
    "mission",
    "slogan"
   ],
   "properties": {
    "backLink": {
     "$ref": "#/definitions/link"
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "categories": {
     "type": "array",
     "minItems": 1,
     "maxItems": 5,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "mission": {
     "type": "string",
     "minLength": 1
    },
    "slogan": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4,
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "content.media.work-hero-image": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "variant",
    "media"
   ],
   "properties": {
    "variant": {
     "enum": [
      "full",
      "clean",
      "plain",
      "drawn"
     ]
    },
    "media": {
     "$ref": "#/definitions/media"
    }
   }
  },
  "content.showcase.app-window": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "screens"
   ],
   "properties": {
    "screens": {
     "type": "array",
     "minItems": 1,
     "maxItems": 12,
     "items": {
      "$ref": "#/definitions/media"
     }
    },
    "mockups": {
     "type": "array",
     "minItems": 0,
     "maxItems": 4,
     "items": {
      "$ref": "#/definitions/media"
     }
    },
    "text": {
     "type": "string",
     "minLength": 1
    },
    "nextLabel": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "content.editorial.mission-text": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "variant",
    "text"
   ],
   "properties": {
    "variant": {
     "enum": [
      "plain",
      "text",
      "titled",
      "web"
     ]
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "text": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "content.gallery.stills": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "media"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "media": {
     "type": "array",
     "minItems": 1,
     "maxItems": 5,
     "items": {
      "$ref": "#/definitions/media"
     }
    }
   }
  },
  "content.gallery.image-row": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "variant",
    "media"
   ],
   "properties": {
    "variant": {
     "enum": [
      "trio",
      "duo",
      "titled"
     ]
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "media": {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "items": {
      "$ref": "#/definitions/media"
     }
    }
   }
  },
  "content.gallery.image-pair": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "media"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "media": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "$ref": "#/definitions/media"
     }
    }
   }
  },
  "content.gallery.triangle": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "media"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "media": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "items": {
      "$ref": "#/definitions/media"
     }
    }
   }
  },
  "content.media.large-image": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "variant",
    "media"
   ],
   "properties": {
    "variant": {
     "enum": [
      "default",
      "clean",
      "covered",
      "tablet",
      "typo"
     ]
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "media": {
     "$ref": "#/definitions/media"
    }
   }
  },
  "content.media.reels": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "reels"
   ],
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "reels": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "poster",
       "video"
      ],
      "properties": {
       "poster": {
        "$ref": "#/definitions/media"
       },
       "video": {
        "$ref": "#/definitions/media"
       },
       "caption": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "content.gallery.carousel": {
   "type": "object",
   "additionalProperties": false,
   "required": [
